import pandas as pd
from pathlib import Path

script_dir = Path(__file__).parent
file_path = script_dir / 'squirrel_edges.csv'

df = pd.read_csv(file_path)

def mean_grade(data):
    return data['id2'].mean()

result = mean_grade(df)
print(f"Mean id2: {result}")


def eighty_or_more(data): 
    filtered = data[data['id2'] >= 80] # pak alleen alle rijen waar dat de id2 meer of gelijk is aan 80
    for _, row in filtered.iterrows():# voor elke rij in gefilterd print dit:
        print(f'student id: {row['id1']}, grade: {row['id2']}')

eighty_or_more(df)


