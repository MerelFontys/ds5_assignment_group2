def draw_mandel(width_square: int) -> np.ndarray: # input: integer, output: numpy array, maakt niet uit welke dimensies
    image = np.zeros((width_square, width_square)) # maak eerst een lege image aan
    for py in range(width_square): # ga elke pixel af in de y-as
        for px in range(width_square): # ga elke pixel af in de x-as
            x = -1.5 + (px / width_square) * (0.5 - (-1.5)) # de pixelpositie omzetten naar een reële waarde binnen het bereik
            y = -1 + (py / width_square) * (1 - (-1)) # de pixelpositie omzetten naar een imaginaire waarde binnen het bereik
            c = complex(x, y) # maak hier een complex getal van: c = x + yi
            
            index = diversion_index(c,100) # bereken de diversion index voor dit getal
            image[py, px] = index # geef de waarde een kleur
    return image 
plot_mand = draw_mandel(200) # maak een mandelbrot afbeelding van 200x200

plt.imshow(plot_mand, extent=[-1.5, 0.5, -1, 1]) # geeft de assen de juiste waardes
plt.colorbar(label='Diverging index')
plt.title('Image Mandelbrot set')
plt.xlabel('Reële deel van c')
plt.ylabel('Imaginaire deel van c')
plt.show()

